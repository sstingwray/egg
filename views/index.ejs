<!DOCTYPE html>
<html>
  <head>
    <title>Einzbern.gg</title>
    <link rel="shortcut icon" href="/images/icons/favicon.ico" type="image/x-icon">
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <link rel="stylesheet" href="/stylesheets/fontawesome.css">
    <link rel="stylesheet" href="/stylesheets/brands.css">
    <link rel="stylesheet" href="/stylesheets/solid.css">
    <script src="/javascripts/jquery.min.js"></script>
    <script src="/javascripts/tinysort.min.js"></script>
    <script src="/javascripts/index.js"></script>
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Rubik One" rel="stylesheet"> 
  </head>
  <body>
    <div class="work-in-progress flex jc-center align-i-center">
        Something is brewing here...
    </div>
    <div class="spinner-container flex jc-center align-i-center"><div class="lds-ring"><div></div><div></div><div></div><div></div></div></div>
    <div class="flex align-i-center jc-center popup">
      <div class="img-form flex col align-i-center jc-center">
        <div class="popup-img-overlay"></div>
        <img class="popup-img" src="" alt="">
        <p class="light popup-img-text"></p>
        <button class="close-popup-btn"><i class="fa fa-times"></i></button>
        <button class="popup-scroll-btn left"><i class="fa-solid fa-chevron-left"></i></button>
        <button class="popup-scroll-btn right"><i class="fa-solid fa-chevron-right"></i></button>
      </div>
      <div class="popup-img-underlay"></div>
    </div>
    <div class="flex row header bg-alt flex col align-i-start">
      <div class="logo flex col jc-start align-i-start">EKATERINA<br>MENABDE</div>
      <div class="flex col header-block">
        <p>Generalist artist with 10 years of experience in gamedev, focused on high-resolution pixel art.</p>
      </div>
      <div class="flex col header-block">
        <div class="folder-container mrg-1em"></div>
      </div>
      <div class="flex col header-block">
        <p class="color-accent-opaq-light">Contacts</p>
        <a class="contact-link" href="mailto:einzbern.mail@gmail.com" target="_blank"><div class="flex row  align-i-center"><img class="icon" src="/images/icons/email.png" alt="">einzbern.mail@gmail.com</div></a>
        <a class="contact-link" href="https://einzbern.bsky.social" target="_blank"><div class="flex row align-i-center"><img class="icon" src="/images/icons/bluesky.png" alt="">@einzbern.bsky.social</div></a>
      </div>
    </div>
    <div class="landing-page-content">
      <div class="flex col mrg-1em">
        <div class="image-container"></div>
      </div>
    </div>
    <div class="template">
      <button class="btn template"></button>
      <div class="flex row align-i-center mrg-01em switch-btn template"><p class="label"></p><div class="switch-container"><label class="switch"><input type="checkbox"><div class="slider"></div></label></div></div>
      <div class="folder template"></div>
      <div class="separator template"></div>
      <div class="flex bg-alt mrg-1em notification template"><p class="mrg-1em notification-text"></p></div>
      <div class="card image template">
        <div class="img-overlay">
          <div class="img-text">
            <p class="light"></p>
          </div>
        </div>
        <img class="card-img" src="" alt="">
      </div>
    </div>
    <div class="flex row wrap jc-space-ar footer">
    </div>
  </body>
</html>
